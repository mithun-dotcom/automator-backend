{
  "manifest_version": 3,
  "name": "DKIM Automator",
  "version": "1.2.0",
  "description": "Runs Google Workspace DKIM steps (generate key, start authentication) in your own signed-in Chrome for the DKIM Automator dashboard.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://admin.google.com/*",
    "https://accounts.google.com/*",
    "https://*.onrender.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DKIM Automator"
  },
  "icons": {
    "128": "icon.png"
  }
}